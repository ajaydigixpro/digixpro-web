# Apache .htaccess configuration for DigiXPro (Static Export)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------
  # SECTION 1: LEGACY 301 REDIRECT RULES
  # ----------------------------------------------------------------------

  # Testimonials & Reviews -> /evidence
  RewriteRule ^testimonials(/.*)?$ /evidence [R=301,L]
  RewriteRule ^reviews/?$ /evidence [R=301,L]
  RewriteRule ^case-studies(/.*)?$ /evidence [R=301,L]

  # About & Team -> /founder
  RewriteRule ^about-us/?$ /founder [R=301,L]
  RewriteRule ^about/?$ /founder [R=301,L]
  RewriteRule ^team/?$ /founder [R=301,L]

  # Standalone Exact /services -> /advisory (Does NOT match /services/[slug])
  RewriteRule ^services/?$ /advisory [R=301,L]

  # Blog -> /knowledge
  RewriteRule ^blog(/.*)?$ /knowledge [R=301,L]

  # Portfolio & Work -> /evidence
  RewriteRule ^portfolio(/.*)?$ /evidence [R=301,L]
  RewriteRule ^work(/.*)?$ /evidence [R=301,L]

  # Contact Aliases -> /contact
  RewriteRule ^get-in-touch/?$ /contact [R=301,L]
  RewriteRule ^schedule/?$ /contact [R=301,L]
  RewriteRule ^book/?$ /contact [R=301,L]

  # Operating Systems -> /evidence/sattvaos
  RewriteRule ^operating-systems/?$ /evidence/sattvaos [R=301,L]

  # ----------------------------------------------------------------------
  # SECTION 2: CLEAN URLS FOR STATIC HTML PAGES (NEXT.JS OUT DIR)
  # Serve page.html for clean route requests
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [NC,L]

  # Custom 404 handler
  ErrorDocument 404 /404.html
</IfModule>

# ----------------------------------------------------------------------
# SECTION 3: SECURITY HEADERS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ----------------------------------------------------------------------
# SECTION 4: AGGRESSIVE BROWSER CACHING FOR ASSETS
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/ico "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
